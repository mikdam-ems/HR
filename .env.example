# Copy to .env.local and fill in.

# Random secret for signing sessions: `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: https://<your-host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only Google accounts on this domain can sign in.
AUTH_ALLOWED_DOMAIN=ems-itech.com

# postgres://user:pass@host:5432/db for a real server.
# Leave empty to use an embedded PostgreSQL (PGlite) stored in .data/ — fine for local development.
DATABASE_URL=

# Local development only: sign in by picking a person, without Google. Ignored in production.
AUTH_DEV_LOGIN=false

# Used by `npm run db:seed` to create the first admin.
SEED_ADMIN_EMAIL=

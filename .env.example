# Copy to .env.local and fill in.

# Random secret for signing sessions: `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: https://<your-host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only Google accounts on this domain can sign in.
AUTH_ALLOWED_DOMAIN=ems-itech.com

# postgres://user:pass@host:5432/db for a real server.
# Leave empty to use an embedded PostgreSQL (PGlite) stored in .data/ — fine for local development.
DATABASE_URL=

# Local development only: sign in by picking a person, without Google. Ignored in production.
AUTH_DEV_LOGIN=false

# Used by `npm run db:seed` to create the first admin.
SEED_ADMIN_EMAIL=

# Brand. BRAND=kadr shows the proposed Kadr product brand by default (see docs/brand/kadr).
# BRAND_PREVIEW=true adds an EMS / Kadr switch to the sign-in page and the account menu so people can compare.
# Demo sites (DEMO_MODE=true) always have the switch. Leave both empty on the live EMS site.
BRAND=
BRAND_PREVIEW=false

# Slack commands (/ems in, /ems out, ...). See slack/README.md
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Print every database query (for finding slow pages)
# DB_LOG=1

# Where DMs and browser notifications link to (defaults to the Vercel production URL)
# APP_URL=https://hr-navy-zeta.vercel.app

# Browser (push) notifications. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:people@ems-itech.com

# Daily job (/api/cron/daily): timesheet reminders and the birthday post. Any long random string: `openssl rand -hex 32`
CRON_SECRET=

# Slack channel ID (e.g. C0123456789) for birthday and work-anniversary posts. Invite the bot: /invite @ems-clock
SLACK_CELEBRATIONS_CHANNEL=
